# Managed by Ansible (common/ansible/roles/wireguard_server). Do not edit on the host.
[Interface]
Address = {{ wireguard_server_address }}
ListenPort = {{ wireguard_server_port }}
PrivateKey = {{ wireguard_server_private_key }}
{% if wireguard_server_forward_between_peers %}
PostUp = iptables -I FORWARD -i %i -o %i -j ACCEPT
PostDown = iptables -D FORWARD -i %i -o %i -j ACCEPT
{% endif %}
{% for p in wireguard_server_peers %}

# {{ p.name }}
[Peer]
PublicKey = {{ p.public_key }}
AllowedIPs = {{ p.allowed_ips }}
{% endfor %}
