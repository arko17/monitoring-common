# Managed by Ansible.
auths:
{% if synology_snmp.version | int == 3 %}
  synology:
    version: 3
    username: "{{ synology_snmp.username }}"
    auth_protocol: {{ synology_snmp.auth_protocol }}
    password: {{ synology_snmp.auth_password | to_json }}
{% if synology_snmp.priv_password | default('') | length > 0 %}
    security_level: authPriv
    priv_protocol: {{ synology_snmp.priv_protocol }}
    priv_password: {{ synology_snmp.priv_password | to_json }}
{% else %}
    security_level: authNoPriv    # DSM: privacy disabled
{% endif %}
{% else %}
  synology:
    community: "{{ synology_snmp_community }}"
    version: 2
{% endif %}
