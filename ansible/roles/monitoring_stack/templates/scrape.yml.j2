# Managed by Ansible. Targets come from the site inventory (file_sd/*.json).
global:
  scrape_interval: {{ scrape_interval }}
  scrape_timeout: 20s

# Self-metrics nobody uses (flag, go_*, Grafana internals) are dropped via the &drop_self anchor.
scrape_configs:
  # --- monitoring stack itself ---------------------------------------------
  - job_name: vmagent
    static_configs: [{targets: ["localhost:8429"]}]
    metric_relabel_configs: &drop_self
      - {source_labels: [__name__], regex: "flag|go_.*|grafana_.*_bucket|grafana_feature_toggles_info|grafana_apiserver_.*", action: drop}
{% if stack_tsdb %}
  - job_name: victoriametrics
    static_configs: [{targets: ["victoriametrics:8428"]}]
    metric_relabel_configs: *drop_self
  - job_name: vmalert
    static_configs: [{targets: ["vmalert:8880"]}]
    metric_relabel_configs: *drop_self
  - job_name: alertmanager
    static_configs: [{targets: ["alertmanager:9093"]}]
    metric_relabel_configs: *drop_self
{% endif %}
{% if stack_grafana %}
  - job_name: grafana
    static_configs: [{targets: ["grafana:3000"]}]
    metric_relabel_configs: *drop_self
{% endif %}
{% if stack_matrix_receiver %}
  - job_name: matrix-receiver
    static_configs: [{targets: ["matrix-receiver:12345"]}]
{% endif %}

  # --- servers ---------------------------------------------------------------
  - job_name: node
    file_sd_configs: [{files: [/etc/vmagent/file_sd/node.json]}]
    metric_relabel_configs:   # unused series dropped at scrape time (checked against all rules/dashboards)
      # systemd: only the "failed" state is used (SystemdUnitFailed)
      - {source_labels: [__name__, state], regex: "node_systemd_unit_state;(active|inactive|activating|deactivating)", action: drop}
      - {source_labels: [__name__], regex: "node_cpu_scaling_governor|node_scrape_collector_.*", action: drop}
      # virtual NICs of containers/VMs on Proxmox hosts (churn with every guest restart)
      - {source_labels: [__name__, device], regex: "node_network_.*;(veth|tap|fwbr|fwpr|fwln).*", action: drop}
  - job_name: smartctl
    scrape_interval: 5m
    file_sd_configs: [{files: [/etc/vmagent/file_sd/smartctl.json]}]
  - job_name: ipmi
    scrape_interval: 1m
    file_sd_configs: [{files: [/etc/vmagent/file_sd/ipmi.json]}]

{% if stack_pve_exporter %}
  # Node-level data from every Proxmox node (survives the loss of any single node) ...
  - job_name: pve
    metrics_path: /pve
    params: {module: [default], cluster: ["0"], node: ["1"]}
    file_sd_configs: [{files: [/etc/vmagent/file_sd/pve.json]}]
    relabel_configs:
      - {source_labels: [__address__], target_label: __param_target}
      - {target_label: __address__, replacement: "pve:9221"}
  # ... and cluster-wide data (guests, storage) only once, from the first host in pve_hosts.
  - job_name: pve-cluster
    metrics_path: /pve
    params: {module: [default], cluster: ["1"], node: ["0"]}
    file_sd_configs: [{files: [/etc/vmagent/file_sd/pve_cluster.json]}]
    relabel_configs:
      - {source_labels: [__address__], target_label: __param_target}
      - {target_label: __address__, replacement: "pve:9221"}
{% endif %}
{% if stack_pbs_exporter %}
  - job_name: pbs
    scrape_interval: 5m
    scrape_timeout: 60s
    file_sd_configs: [{files: [/etc/vmagent/file_sd/pbs.json]}]
    relabel_configs:
      - {source_labels: [__address__], regex: "(.*)", replacement: "https://$1:8007", target_label: __param_target}
      - {target_label: __address__, replacement: "pbs:10019"}
{% endif %}
{% if stack_snmp %}
  - job_name: synology
    scrape_interval: 2m
    metrics_path: /snmp
    params: {module: [if_mib, synology], auth: [synology]}
    file_sd_configs: [{files: [/etc/vmagent/file_sd/synology.json]}]
    relabel_configs:
      - {source_labels: [__address__], target_label: __param_target}
      - {target_label: __address__, replacement: "snmp:9116"}
{% endif %}

{% if stack_rct_exporter %}
  - job_name: rct           # solar inverter; the exporter reads it on every scrape
    scrape_interval: 30s
    scrape_timeout: 25s
    static_configs: [{targets: ["rct:9894"], labels: {instance: solar-inverter}}]
{% endif %}

{% if stack_pihole_exporter %}
  - job_name: pihole
    scrape_interval: 60s
    static_configs: [{targets: ["pihole:9617"], labels: {instance: pihole}}]
{% endif %}

{% if stack_blackbox %}
  # --- probes ----------------------------------------------------------------
  - job_name: blackbox-services
    metrics_path: /probe
    file_sd_configs: [{files: [/etc/vmagent/file_sd/services.json]}]
    relabel_configs:
      - {source_labels: [__address__], target_label: __param_target}
      - {source_labels: [module], target_label: __param_module}
      - {target_label: __address__, replacement: "blackbox:9115"}
  - job_name: blackbox-devices      # informational only, no alerts
    scrape_interval: 2m
    metrics_path: /probe
    file_sd_configs: [{files: [/etc/vmagent/file_sd/devices.json]}]
    relabel_configs:
      - {source_labels: [__address__], target_label: __param_target}
      - {source_labels: [module], target_label: __param_module}
      - {target_label: __address__, replacement: "blackbox:9115"}
  - job_name: blackbox-workstations
    scrape_interval: 2m
    metrics_path: /probe
    params: {module: [icmp]}
    file_sd_configs: [{files: [/etc/vmagent/file_sd/workstations.json]}]
    relabel_configs:
      - {source_labels: [__address__], target_label: __param_target}
      - {target_label: __address__, replacement: "blackbox:9115"}
{% endif %}

{% if extra_scrape_configs %}
  # --- site specific ----------------------------------------------------------
  {{ extra_scrape_configs | to_nice_yaml(indent=2) | indent(2) }}
{% endif %}
